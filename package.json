{
  "name": "lcu-auto",
  "version": "0.4.1",
  "private": false,
  "description": "Local and remote MCP access to LCU with persistent computer-use sessions and locally managed app consent.",
  "keywords": [
    "automation",
    "cli",
    "computer-use",
    "effect",
    "lcu",
    "mcp"
  ],
  "homepage": "https://github.com/yoyooyooo/lcu-auto#readme",
  "bugs": {
    "url": "https://github.com/yoyooyooo/lcu-auto/issues"
  },
  "license": "MIT",
  "author": "yoyooyooo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyooyooo/lcu-auto.git"
  },
  "bin": {
    "lcu-auto": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "start": "node dist/cli.js",
    "build": "bun scripts/build.ts",
    "shim:install": "bun scripts/install-shim.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings src tests scripts",
    "docs:check": "bun scripts/check-docs.ts",
    "privacy:check": "bun scripts/check-public.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run docs:check && bun run privacy:check",
    "pack:check": "bun scripts/check-package.ts",
    "release": "bun scripts/release.ts",
    "release:precheck": "bun scripts/release.ts --precheck",
    "smoke:live": "bun scripts/live-smoke.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "effect": "4.1.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "bun@1.4.3"
}
